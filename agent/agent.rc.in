#include <winver.h>
VS_VERSION_INFO VERSIONINFO
 FILEVERSION @AGENT_FILE_VERSION@
 PRODUCTVERSION @AGENT_FILE_VERSION@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS @AGENT_FILE_FLAGS@
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", "HyperFamily\0"
   VALUE "FileDescription", "HyperFamily Native Store Inventory Agent\0"
   VALUE "FileVersion", "@AGENT_VERSION@\0"
   VALUE "InternalName", "HyperFamilyStoreAgent\0"
   VALUE "OriginalFilename", "HyperFamilyStoreAgent.exe\0"
   VALUE "ProductName", "HyperFamily Store Inventory Agent\0"
   VALUE "ProductVersion", "@AGENT_VERSION@\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
